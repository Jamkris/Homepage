# SQLite database file location (libsql URL)
DATABASE_URL=file:./data/homepage.db

# Secret used for Payload auth — generate with: openssl rand -hex 24
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of the site (used for SEO metadata, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Directory for uploaded media files (defaults to ./media when unset)
# MEDIA_DIR=/data/media
